+// static
+bool HttpUtil::IsLikelyContentAddressedUrl(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIs(url::kHttpsScheme)) {
+    return false;
+  }
+  std::string_view path = url.path();
+  size_t slash = path.rfind('/');
+  std::string_view segment =
+      slash == std::string_view::npos ? path : path.substr(slash + 1);
+  size_t dot = segment.rfind('.');
+  if (dot == std::string_view::npos || dot == 0) {
+    return false;
+  }
+  static constexpr std::string_view kExtensions[] = {
+      "js",  "mjs", "css",  "woff2", "woff", "ttf",  "otf",  "wasm",
+      "png", "jpg", "jpeg", "webp",  "avif", "gif",  "svg",  "ico"};
+  std::string_view extension = segment.substr(dot + 1);
+  if (std::ranges::none_of(kExtensions, [&](std::string_view e) {
+        return base::EqualsCaseInsensitiveASCII(extension, e);
+      })) {
+    return false;
+  }
+  for (std::string_view token :
+       base::SplitStringPiece(segment.substr(0, dot), ".-_",
+                              base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (IsHashLikeToken(token)) {
+      return true;
+    }
+  }
+  return false;
+}
