+bool HttpCache::Transaction::IsFreshContentAddressedResponse() const {
+  if (!base::FeatureList::IsEnabled(features::kContentAddressedImmutable)) {
+    return false;
+  }
+  const HttpResponseHeaders& headers = *response_.headers;
+  if (method_ != "GET" || headers.response_code() != HTTP_OK ||
+      !headers.HasValidators() ||
+      headers.HasHeaderValue("cache-control", "no-cache") ||
+      headers.HasHeaderValue("cache-control", "no-store") ||
+      headers.HasHeaderValue("pragma", "no-cache") ||
+      !HttpUtil::IsLikelyContentAddressedUrl(request_->url)) {
+    return false;
+  }
+  return headers.GetCurrentAge(response_.request_time, response_.response_time,
+                               cache_->clock_->Now()) <
+         features::kContentAddressedFreshness.Get();
 }
 
