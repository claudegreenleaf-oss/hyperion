+// A hex digest (webpack, esbuild, Rollup default) or a base64url-style digest
+// (Vite, Parcel). Requiring a digit, and for the non-hex form mixed case with no
+// run of four lowercase letters, keeps ordinary words such as "LoginForm",
+// "Html5Player" or "deadbeef" from qualifying.
+bool IsHashLikeToken(std::string_view token) {
+  if (token.size() < 8 || token.size() > 64) {
+    return false;
+  }
+  bool has_digit = false, has_lower = false, has_upper = false;
+  bool all_hex = true;
+  size_t lower_run = 0, max_lower_run = 0;
+  for (char c : token) {
+    if (base::IsAsciiLower(c)) {
+      has_lower = true;
+      all_hex &= c <= 'f';
+      max_lower_run = std::max(max_lower_run, ++lower_run);
+      continue;
+    }
+    lower_run = 0;
+    if (base::IsAsciiDigit(c)) {
+      has_digit = true;
+    } else if (base::IsAsciiUpper(c)) {
+      has_upper = true;
+      all_hex = false;
+    } else {
+      return false;
+    }
+  }
+  if (!has_digit) {
+    return false;
+  }
+  if (all_hex) {
+    return has_lower;
+  }
+  return has_lower && has_upper && token.size() <= 16 && max_lower_run < 4;
+}
