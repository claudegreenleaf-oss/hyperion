+// static
+PrerenderHostRegistry::HyperionIntent PrerenderHostRegistry::HyperionIntentFor(
+    const PrerenderAttributes& attributes) {
+  return HyperionIntent{
+      .confidence = attributes.hyperion_confidence / 100.0,
+      .half_life = attributes.hyperion_model_prediction
+                       ? kHyperionModelIntentHalfLife
+                       : kHyperionPointerIntentHalfLife,
+      .since = base::TimeTicks::Now()};
+}
+
+double PrerenderHostRegistry::HyperionValue(PrerenderHostId host_id,
+                                            base::TimeTicks now) const {
+  auto it = hyperion_intent_.find(host_id);
+  if (it == hyperion_intent_.end()) {
+    // A host put back after a failed reuse lost its record; treat it as a
+    // fresh pointer trigger.
+    return 1.0;
+  }
+  const HyperionIntent& intent = it->second;
+  return intent.confidence *
+         std::exp2(-(now - intent.since) / intent.half_life);
+}
+
+PrerenderHostId PrerenderHostRegistry::HyperionLeastValuable(
+    const base::circular_deque<PrerenderHostId>& queue,
+    double& value) const {
+  CHECK(!queue.empty());
+  const base::TimeTicks now = base::TimeTicks::Now();
+  // Ties go to the oldest host, which keeps Chromium's FIFO order when every
+  // host carries the same evidence.
+  PrerenderHostId least = queue.front();
+  value = HyperionValue(least, now);
+  for (PrerenderHostId host_id : queue) {
+    const double host_value = HyperionValue(host_id, now);
+    if (host_value < value) {
+      least = host_id;
+      value = host_value;
+    }
+  }
+  return least;
 }
 
