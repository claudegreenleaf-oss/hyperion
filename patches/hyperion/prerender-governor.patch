+// Hyperion: the non-immediate limit grows with available memory, one
+// prerender per kHyperionMemoryPerPrerenderMb above the reserve, between
+// Chromium's fixed limit and kHyperionMaxNonImmediatePrerenders.
+TEST_P(PrerenderHostRegistryLimitGroupTest, HyperionNonImmediateLimitTracksMemory) {
+  using Registry = PrerenderHostRegistry;
+  const auto group = PrerenderLimitGroup::kSpeculationRulesNonImmediate;
+
+  Registry::SetHyperionAvailableMemoryMbForTesting(0);
+  EXPECT_EQ(registry().GetScaledLimitForTesting(group),
+            Registry::kMaxRunningSpeculationRulesNonImmediatePrerenders);
+
+  Registry::SetHyperionAvailableMemoryMbForTesting(
+      Registry::kHyperionReservedMemoryMb +
+      4 * Registry::kHyperionMemoryPerPrerenderMb);
+  EXPECT_EQ(registry().GetScaledLimitForTesting(group), 4);
+
+  Registry::SetHyperionAvailableMemoryMbForTesting(1 << 20);
+  EXPECT_EQ(registry().GetScaledLimitForTesting(group),
+            Registry::kHyperionMaxNonImmediatePrerenders);
+}
+
+// Hyperion: a full non-immediate group evicts its least valuable host, not its
+// oldest, and refuses a trigger worth less than every running host.
+TEST_P(PrerenderHostRegistryLimitGroupTest, HyperionEvictsLeastValuable) {
+  ASSERT_EQ(registry().GetScaledLimitForTesting(
+                PrerenderLimitGroup::kSpeculationRulesNonImmediate),
+            2);
+
+  // Oldest: a pointer trigger. Second: a weak navigation-model prediction.
+  PrerenderHostId pointer = CreateNonImmediateHost(100, false);
+  PrerenderHostId weak_model = CreateNonImmediateHost(40, true);
+  ASSERT_TRUE(pointer);
+  ASSERT_TRUE(weak_model);
+
+  // A third pointer trigger evicts the weak prediction, not the oldest host.
+  PrerenderHostId pointer2 = CreateNonImmediateHost(100, false);
+  ASSERT_TRUE(pointer2);
+  EXPECT_TRUE(IsRunning(pointer));
+  EXPECT_FALSE(IsRunning(weak_model));
+  EXPECT_TRUE(IsRunning(pointer2));
+
+  // A prediction weaker than both running hosts is refused.
+  EXPECT_FALSE(CreateNonImmediateHost(30, true));
+  EXPECT_TRUE(IsRunning(pointer));
+  EXPECT_TRUE(IsRunning(pointer2));
 }
 
