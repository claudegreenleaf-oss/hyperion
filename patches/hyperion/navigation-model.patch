diff --git a/chrome/browser/navigation_predictor/hyperion_navigation_model.cc b/chrome/browser/navigation_predictor/hyperion_navigation_model.cc
new file mode 100644
index 0000000000..fe09f3b92d
--- /dev/null
+++ b/chrome/browser/navigation_predictor/hyperion_navigation_model.cc
@@ -0,0 +1,296 @@
+// Copyright 2026 The Hyperion Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/navigation_predictor/hyperion_navigation_model.h"
+
+#include <algorithm>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+#include "url/origin.h"
+
+namespace {
+
+constexpr int kFormatVersion = 1;
+constexpr char kExactPrefix[] = "e|";
+constexpr char kTemplatePrefix[] = "t|";
+
+// A path segment is ID-like if it carries a run of two or more digits, or is a
+// long token mixing letters and digits (UUIDs, hashes, slugs with IDs).
+bool IsIdLikeSegment(std::string_view segment) {
+  size_t digit_run = 0;
+  bool has_digit = false;
+  for (char c : segment) {
+    if (base::IsAsciiDigit(c)) {
+      has_digit = true;
+      if (++digit_run >= 2) {
+        return true;
+      }
+    } else {
+      digit_run = 0;
+    }
+  }
+  return has_digit && segment.size() >= 16;
+}
+
+std::string TemplatePath(std::string_view path) {
+  std::vector<std::string_view> segments = base::SplitStringPiece(
+      path, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  for (std::string_view& segment : segments) {
+    if (IsIdLikeSegment(segment)) {
+      segment = "*";
+    }
+  }
+  return base::JoinString(segments, "/");
+}
+
+}  // namespace
+
+HyperionNavigationModel::Source::Source() = default;
+HyperionNavigationModel::Source::Source(const Source&) = default;
+HyperionNavigationModel::Source& HyperionNavigationModel::Source::operator=(
+    const Source&) = default;
+HyperionNavigationModel::Source::~Source() = default;
+
+HyperionNavigationModel::HyperionNavigationModel(
+    const base::FilePath& profile_path) {
+  if (profile_path.empty()) {
+    loaded_ = true;
+    return;
+  }
+  base::FilePath file = profile_path.Append(kFileName);
+  scoped_refptr<base::SequencedTaskRunner> task_runner =
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN});
+  writer_ = std::make_unique<base::ImportantFileWriter>(file, task_runner,
+                                                        base::Seconds(30));
+  task_runner->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](const base::FilePath& path) -> std::optional<std::string> {
+            std::string contents;
+            if (!base::ReadFileToString(path, &contents)) {
+              return std::nullopt;
+            }
+            return contents;
+          },
+          file),
+      base::BindOnce(&HyperionNavigationModel::OnLoaded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+HyperionNavigationModel::~HyperionNavigationModel() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (writer_ && writer_->HasPendingWrite()) {
+    writer_->DoScheduledWrite();
+  }
+}
+
+// static
+std::string HyperionNavigationModel::ExactKey(const GURL& url) {
+  return base::StrCat({url.DeprecatedGetOriginAsURL().spec(), url.path().substr(1)});
+}
+
+// static
+std::string HyperionNavigationModel::TemplateKey(const GURL& url) {
+  return url.DeprecatedGetOriginAsURL().spec() +
+         TemplatePath(url.path()).substr(1);
+}
+
+void HyperionNavigationModel::RecordView(const GURL& page) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!loaded_ || !page.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  std::string exact = ExactKey(page);
+  std::string templ = TemplateKey(page);
+  Touch(kExactPrefix + exact).views++;
+  if (templ != exact) {
+    Touch(kTemplatePrefix + templ).views++;
+  }
+  EvictIfNeeded();
+  ScheduleWrite();
+}
+
+void HyperionNavigationModel::RecordClick(const GURL& page,
+                                          const GURL& target) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!loaded_ || !page.SchemeIsHTTPOrHTTPS() ||
+      url::Origin::Create(page) != url::Origin::Create(target)) {
+    return;
+  }
+  std::string exact = ExactKey(page);
+  std::string templ = TemplateKey(page);
+  AddClick(Touch(kExactPrefix + exact), target.GetWithoutRef().spec());
+  if (templ != exact) {
+    AddClick(Touch(kTemplatePrefix + templ), TemplateKey(target));
+  }
+  EvictIfNeeded();
+  ScheduleWrite();
+}
+
+float HyperionNavigationModel::Score(const GURL& page,
+                                     const GURL& target) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!loaded_ || !page.SchemeIsHTTPOrHTTPS() ||
+      url::Origin::Create(page) != url::Origin::Create(target)) {
+    return 0.f;
+  }
+  std::string exact = ExactKey(page);
+  std::string templ = TemplateKey(page);
+  auto [exact_views, exact_clicks] =
+      Counts(kExactPrefix + exact, target.GetWithoutRef().spec());
+  uint32_t templ_views = 0, templ_clicks = 0;
+  if (templ != exact) {
+    std::tie(templ_views, templ_clicks) =
+        Counts(kTemplatePrefix + templ, TemplateKey(target));
+  }
+  if (std::max(exact_clicks, templ_clicks) < kMinClicks) {
+    return 0.f;
+  }
+  // Additive smoothing: a link clicked on every one of two visits scores 0.5,
+  // not 1.0, until more evidence arrives.
+  auto estimate = [](uint32_t clicks, uint32_t views) {
+    return views == 0 ? 0.f
+                      : std::min(1.f, clicks / (static_cast<float>(views) + 2.f));
+  };
+  float exact_p = estimate(exact_clicks, exact_views);
+  if (templ == exact) {
+    return exact_p;
+  }
+  float lambda = exact_views / (static_cast<float>(exact_views) + 3.f);
+  return lambda * exact_p + (1.f - lambda) * estimate(templ_clicks, templ_views);
+}
+
+void HyperionNavigationModel::Clear() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  sources_.clear();
+  ScheduleWrite();
+}
+
+std::optional<std::string> HyperionNavigationModel::SerializeData() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  base::DictValue sources;
+  for (const auto& [key, source] : sources_) {
+    base::DictValue clicks;
+    for (const auto& [target, count] : source.clicks) {
+      clicks.Set(target, static_cast<int>(count));
+    }
+    sources.Set(key, base::DictValue()
+                         .Set("n", static_cast<int>(source.views))
+                         .Set("t", source.last_used.InSecondsFSinceUnixEpoch())
+                         .Set("c", std::move(clicks)));
+  }
+  return base::WriteJson(base::DictValue()
+                             .Set("v", kFormatVersion)
+                             .Set("sources", std::move(sources)));
+}
+
+HyperionNavigationModel::Source& HyperionNavigationModel::Touch(
+    const std::string& key) {
+  Source& source = sources_[key];
+  source.last_used = base::Time::Now();
+  if (source.views >= kSaturationViews) {
+    source.views /= 2;
+    for (auto& [target, count] : source.clicks) {
+      count /= 2;
+    }
+    std::erase_if(source.clicks, [](const auto& kv) { return kv.second == 0; });
+  }
+  return source;
+}
+
+void HyperionNavigationModel::AddClick(Source& source,
+                                       const std::string& target_key) {
+  source.clicks[target_key]++;
+  // A click implies a view of the source page even if the view was missed
+  // (for example, the page was restored from the back/forward cache).
+  source.views = std::max(source.views, source.clicks[target_key]);
+  if (source.clicks.size() > kMaxTargetsPerSource) {
+    auto weakest = std::ranges::min_element(
+        source.clicks, {}, [](const auto& kv) { return kv.second; });
+    source.clicks.erase(weakest);
+  }
+}
+
+void HyperionNavigationModel::EvictIfNeeded() {
+  if (sources_.size() <= kMaxSources) {
+    return;
+  }
+  // Drop the least recently used tenth in one pass so eviction stays rare.
+  std::vector<std::pair<base::Time, std::string>> by_age;
+  by_age.reserve(sources_.size());
+  for (const auto& [key, source] : sources_) {
+    by_age.emplace_back(source.last_used, key);
+  }
+  size_t to_drop = sources_.size() - kMaxSources * 9 / 10;
+  std::ranges::nth_element(by_age, by_age.begin() + to_drop);
+  for (size_t i = 0; i < to_drop; ++i) {
+    sources_.erase(by_age[i].second);
+  }
+}
+
+void HyperionNavigationModel::ScheduleWrite() {
+  if (writer_) {
+    writer_->ScheduleWrite(this);
+  }
+}
+
+void HyperionNavigationModel::OnLoaded(std::optional<std::string> contents) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  loaded_ = true;
+  if (!contents) {
+    return;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(*contents, base::JSON_PARSE_RFC);
+  if (!root || root->FindInt("v") != kFormatVersion) {
+    return;
+  }
+  const base::DictValue* sources = root->FindDict("sources");
+  if (!sources) {
+    return;
+  }
+  for (const auto [key, value] : *sources) {
+    const base::DictValue* dict = value.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    Source source;
+    source.views = std::max(0, dict->FindInt("n").value_or(0));
+    source.last_used = base::Time::FromSecondsSinceUnixEpoch(
+        dict->FindDouble("t").value_or(0));
+    if (const base::DictValue* clicks = dict->FindDict("c")) {
+      for (const auto [target, count] : *clicks) {
+        if (count.is_int() && count.GetInt() > 0) {
+          source.clicks[target] = count.GetInt();
+        }
+      }
+    }
+    sources_[key] = std::move(source);
+  }
+  EvictIfNeeded();
+}
+
+std::pair<uint32_t, uint32_t> HyperionNavigationModel::Counts(
+    const std::string& source_key,
+    const std::string& target_key) const {
+  auto it = sources_.find(source_key);
+  if (it == sources_.end()) {
+    return {0, 0};
+  }
+  auto click = it->second.clicks.find(target_key);
+  return {it->second.views,
+          click == it->second.clicks.end() ? 0 : click->second};
+}
diff --git a/chrome/browser/navigation_predictor/hyperion_navigation_model.h b/chrome/browser/navigation_predictor/hyperion_navigation_model.h
new file mode 100644
index 0000000000..8f05985d71
--- /dev/null
+++ b/chrome/browser/navigation_predictor/hyperion_navigation_model.h
@@ -0,0 +1,103 @@
+// Copyright 2026 The Hyperion Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_NAVIGATION_PREDICTOR_HYPERION_NAVIGATION_MODEL_H_
+#define CHROME_BROWSER_NAVIGATION_PREDICTOR_HYPERION_NAVIGATION_MODEL_H_
+
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/important_file_writer.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/time/time.h"
+#include "url/gurl.h"
+
+// A local next-navigation model learned from the user's own link clicks.
+//
+// For every page it counts page views and the same-origin links followed from
+// that page, and estimates the probability that a link is followed next with a
+// smoothed first-order Markov estimate. Pages are keyed twice: by exact
+// origin + path, and by a template in which ID-like path segments are
+// wildcarded, so "/item/123" and "/item/456" share evidence. The exact estimate
+// is blended with the template one in proportion to how much exact evidence
+// exists, the back-off used by selective Markov models for web prediction
+// (Deshpande and Karypis, ACM TOIT 2004). States with too little support never
+// produce a prediction.
+//
+// The model replaces the remote ML preloading model that ungoogled-chromium
+// removes. It never leaves the profile directory and is cleared with history.
+class HyperionNavigationModel
+    : public base::ImportantFileWriter::DataSerializer {
+ public:
+  static constexpr base::FilePath::CharType kFileName[] =
+      FILE_PATH_LITERAL("Hyperion Navigation Model");
+
+  static constexpr size_t kMaxSources = 4000;
+  static constexpr size_t kMaxTargetsPerSource = 16;
+  // A link needs at least this many recorded clicks before it is predicted.
+  static constexpr uint32_t kMinClicks = 2;
+  // Counts are halved once a page has this many views, so old habits fade.
+  static constexpr uint32_t kSaturationViews = 512;
+
+  // An empty `profile_path` keeps the model in memory only.
+  explicit HyperionNavigationModel(const base::FilePath& profile_path);
+  HyperionNavigationModel(const HyperionNavigationModel&) = delete;
+  HyperionNavigationModel& operator=(const HyperionNavigationModel&) = delete;
+  ~HyperionNavigationModel() override;
+
+  void RecordView(const GURL& page);
+  void RecordClick(const GURL& page, const GURL& target);
+
+  // Probability in [0, 1] that `target` is the next navigation from `page`.
+  // Returns 0 when there is not enough evidence or the origins differ.
+  float Score(const GURL& page, const GURL& target) const;
+
+  void Clear();
+
+  bool loaded() const { return loaded_; }
+  size_t source_count_for_testing() const { return sources_.size(); }
+
+  static std::string ExactKey(const GURL& url);
+  static std::string TemplateKey(const GURL& url);
+
+  // base::ImportantFileWriter::DataSerializer:
+  std::optional<std::string> SerializeData() override;
+
+ private:
+  struct Source {
+    Source();
+    Source(const Source&);
+    Source& operator=(const Source&);
+    ~Source();
+
+    uint32_t views = 0;
+    base::Time last_used;
+    std::map<std::string, uint32_t> clicks;
+  };
+
+  // Increments the view or click counters of `key`, creating it if needed.
+  Source& Touch(const std::string& key);
+  void AddClick(Source& source, const std::string& target_key);
+  void EvictIfNeeded();
+  void ScheduleWrite();
+  void OnLoaded(std::optional<std::string> contents);
+
+  // Returns {views, clicks} for `target_key` under `source_key`.
+  std::pair<uint32_t, uint32_t> Counts(const std::string& source_key,
+                                       const std::string& target_key) const;
+
+  std::map<std::string, Source> sources_;
+  bool loaded_ = false;
+  std::unique_ptr<base::ImportantFileWriter> writer_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<HyperionNavigationModel> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_NAVIGATION_PREDICTOR_HYPERION_NAVIGATION_MODEL_H_
diff --git a/chrome/browser/navigation_predictor/hyperion_navigation_model_unittest.cc b/chrome/browser/navigation_predictor/hyperion_navigation_model_unittest.cc
new file mode 100644
index 0000000000..c7fb62ad6e
--- /dev/null
+++ b/chrome/browser/navigation_predictor/hyperion_navigation_model_unittest.cc
@@ -0,0 +1,138 @@
+// Copyright 2026 The Hyperion Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/navigation_predictor/hyperion_navigation_model.h"
+
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/test/task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace {
+
+class HyperionNavigationModelTest : public testing::Test {
+ protected:
+  base::test::TaskEnvironment task_environment_;
+};
+
+const GURL kHome("https://news.test/");
+const GURL kStory("https://news.test/story/42#comments");
+const GURL kAbout("https://news.test/about");
+
+void Visit(HyperionNavigationModel& model,
+           const GURL& page,
+           const GURL& clicked) {
+  model.RecordView(page);
+  if (clicked.is_valid()) {
+    model.RecordClick(page, clicked);
+  }
+}
+
+TEST_F(HyperionNavigationModelTest, UnseenLinkScoresZero) {
+  HyperionNavigationModel model{base::FilePath()};
+  EXPECT_EQ(0.f, model.Score(kHome, kStory));
+  model.RecordView(kHome);
+  EXPECT_EQ(0.f, model.Score(kHome, kStory));
+}
+
+TEST_F(HyperionNavigationModelTest, NeedsTwoClicks) {
+  HyperionNavigationModel model{base::FilePath()};
+  Visit(model, kHome, kStory);
+  EXPECT_EQ(0.f, model.Score(kHome, kStory));
+  Visit(model, kHome, kStory);
+  // Two clicks in two views, smoothed: 2 / (2 + 2).
+  EXPECT_FLOAT_EQ(0.5f, model.Score(kHome, kStory));
+  // The fragment is not part of the target identity.
+  EXPECT_FLOAT_EQ(0.5f, model.Score(kHome, GURL("https://news.test/story/42")));
+}
+
+TEST_F(HyperionNavigationModelTest, ProbabilityTracksFollowRate) {
+  HyperionNavigationModel model{base::FilePath()};
+  for (int i = 0; i < 8; ++i) {
+    Visit(model, kHome, i % 4 == 0 ? kAbout : kStory);
+  }
+  float story = model.Score(kHome, kStory);
+  float about = model.Score(kHome, kAbout);
+  EXPECT_GT(story, about);
+  EXPECT_FLOAT_EQ(6.f / 10.f, story);
+  EXPECT_FLOAT_EQ(2.f / 10.f, about);
+}
+
+TEST_F(HyperionNavigationModelTest, IgnoresCrossOriginAndNonHttp) {
+  HyperionNavigationModel model{base::FilePath()};
+  const GURL other("https://other.test/story/42");
+  for (int i = 0; i < 3; ++i) {
+    Visit(model, kHome, other);
+  }
+  EXPECT_EQ(0.f, model.Score(kHome, other));
+  model.RecordView(GURL("file:///tmp/a.html"));
+  EXPECT_EQ(0.f,
+            model.Score(GURL("file:///tmp/a.html"), GURL("file:///tmp/b.html")));
+}
+
+TEST_F(HyperionNavigationModelTest, TemplateBackOffSharesEvidence) {
+  HyperionNavigationModel model{base::FilePath()};
+  for (int id = 100; id < 104; ++id) {
+    std::string item = "https://shop.test/item/" + base::NumberToString(id);
+    Visit(model, GURL(item), GURL(item + "/reviews"));
+  }
+  // An item page never seen before inherits the pattern from its template.
+  EXPECT_GT(model.Score(GURL("https://shop.test/item/999"),
+                        GURL("https://shop.test/item/999/reviews")),
+            0.5f);
+  EXPECT_EQ(0.f, model.Score(GURL("https://shop.test/item/999"),
+                             GURL("https://shop.test/cart")));
+}
+
+TEST_F(HyperionNavigationModelTest, TemplateKeys) {
+  EXPECT_EQ("https://a.test/item/*/reviews",
+            HyperionNavigationModel::TemplateKey(
+                GURL("https://a.test/item/123/reviews?x=1")));
+  EXPECT_EQ("https://a.test/blog/v2/post",
+            HyperionNavigationModel::TemplateKey(
+                GURL("https://a.test/blog/v2/post")));
+  EXPECT_EQ("https://a.test/u/*",
+            HyperionNavigationModel::TemplateKey(GURL(
+                "https://a.test/u/3f2504e0-4f89-11d3-9a0c-0305e82c3301")));
+}
+
+TEST_F(HyperionNavigationModelTest, ClearForgetsEverything) {
+  HyperionNavigationModel model{base::FilePath()};
+  Visit(model, kHome, kStory);
+  Visit(model, kHome, kStory);
+  ASSERT_GT(model.Score(kHome, kStory), 0.f);
+  model.Clear();
+  EXPECT_EQ(0.f, model.Score(kHome, kStory));
+  EXPECT_EQ(0u, model.source_count_for_testing());
+}
+
+TEST_F(HyperionNavigationModelTest, SourceCountIsBounded) {
+  HyperionNavigationModel model{base::FilePath()};
+  for (size_t i = 0; i < HyperionNavigationModel::kMaxSources + 50; ++i) {
+    model.RecordView(GURL("https://a.test/p" + base::NumberToString(i) + "x"));
+  }
+  EXPECT_LE(model.source_count_for_testing(),
+            HyperionNavigationModel::kMaxSources);
+}
+
+TEST_F(HyperionNavigationModelTest, PersistsAcrossRestarts) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  {
+    HyperionNavigationModel model(dir.GetPath());
+    task_environment_.RunUntilIdle();
+    ASSERT_TRUE(model.loaded());
+    Visit(model, kHome, kStory);
+    Visit(model, kHome, kStory);
+  }
+  task_environment_.RunUntilIdle();
+  HyperionNavigationModel reloaded(dir.GetPath());
+  EXPECT_FALSE(reloaded.loaded());
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(reloaded.loaded());
+  EXPECT_FLOAT_EQ(0.5f, reloaded.Score(kHome, kStory));
+}
+
+}  // namespace
diff --git a/chrome/browser/navigation_predictor/navigation_predictor.cc b/chrome/browser/navigation_predictor/navigation_predictor.cc
index 47a1796f0e..e9a26b43ff 100644
--- a/chrome/browser/navigation_predictor/navigation_predictor.cc
+++ b/chrome/browser/navigation_predictor/navigation_predictor.cc
