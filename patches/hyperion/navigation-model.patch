+
+void NavigationPredictor::ScheduleHyperionScoring() {
+  if (!base::FeatureList::IsEnabled(
+          blink::features::kPreloadingHeuristicsMLModel) ||
+      hyperion_scoring_timer_.IsRunning() ||
+      hyperion_scoring_passes_ >=
+          static_cast<int>(std::size(kHyperionScoringDelays))) {
+    return;
+  }
+  hyperion_scoring_timer_.Start(
+      FROM_HERE, kHyperionScoringDelays[hyperion_scoring_passes_],
+      base::BindOnce(&NavigationPredictor::ScoreAnchorsWithHyperionModel,
+                     base::Unretained(this)));
+}
+
+void NavigationPredictor::ScoreAnchorsWithHyperionModel() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  hyperion_scoring_passes_++;
+  HyperionNavigationModel* model = GetHyperionNavigationModel();
+  if (!model) {
+    return;
+  }
+  const GURL document_url =
+      render_frame_host().GetLastCommittedURL().GetWithoutRef();
+  std::vector<std::pair<float, GURL>> scored;
+  std::set<size_t> seen;
+  for (const auto& [anchor_id, anchor] : anchors_) {
+    if (IsTargetURLTheSameAsDocument(anchor)) {
+      continue;
+    }
+    GURL target = anchor.target_url.GetWithoutRef();
+    if (!seen.insert(base::FastHash(target.spec())).second) {
+      continue;
+    }
+    float score = model->Score(document_url, target);
+    if (score > 0.f) {
+      scored.emplace_back(score, std::move(target));
+    }
+  }
+  std::ranges::sort(scored, std::ranges::greater(), &std::pair<float, GURL>::first);
+  if (scored.size() > kHyperionMaxPredictionsPerPass) {
+    scored.resize(kHyperionMaxPredictionsPerPass);
+  }
+  // The decider applies the prefetch threshold and only enacts predictions
+  // that match a moderate-eagerness speculation candidate on the page.
+  for (const auto& [score, url] : scored) {
+    render_frame_host().OnPreloadingHeuristicsModelDone(url, score);
+  }
+  ScheduleHyperionScoring();
+}
