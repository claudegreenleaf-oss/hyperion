+// Tests that a non-immediate prerender with high confidence gets a warmed
+// compositor and a pre-built paint tree, while low-confidence and immediate
+// prerenders stay cold.
+TEST_F(PrerendererTest, HyperionWarmsLikelyActivations) {
+  PrerenderHostRegistry* registry = GetPrerenderHostRegistry();
+  PrerendererImpl prerenderer(*GetRenderFrameHost());
+
+  const GURL kHoverUrl = GetSameOriginUrl("/empty.html?hover");
+  prerenderer.MaybePrerender(
+      CreatePrerenderCandidateWithEagerness(
+          kHoverUrl, blink::mojom::SpeculationEagerness::kModerate),
+      preloading_predictor::kUnspecified, PreloadingConfidence{100});
+  PrerenderHost* hover = registry->FindHostByUrlForTesting(kHoverUrl);
+  ASSERT_TRUE(hover);
+  EXPECT_TRUE(hover->should_warm_up_compositor());
+  EXPECT_TRUE(hover->should_prepare_paint_tree());
+
+  const GURL kUnsureUrl = GetSameOriginUrl("/empty.html?unsure");
+  prerenderer.MaybePrerender(
+      CreatePrerenderCandidateWithEagerness(
+          kUnsureUrl, blink::mojom::SpeculationEagerness::kModerate),
+      preloading_predictor::kUnspecified, PreloadingConfidence{20});
+  PrerenderHost* unsure = registry->FindHostByUrlForTesting(kUnsureUrl);
+  ASSERT_TRUE(unsure);
+  EXPECT_FALSE(unsure->should_prepare_paint_tree());
+
+  const GURL kImmediateUrl = GetSameOriginUrl("/empty.html?immediate");
+  std::vector<blink::mojom::SpeculationCandidatePtr> candidates;
+  candidates.push_back(CreatePrerenderCandidate(kImmediateUrl));
+  prerenderer.ProcessCandidatesForPrerender(std::move(candidates));
+  PrerenderHost* immediate = registry->FindHostByUrlForTesting(kImmediateUrl);
+  ASSERT_TRUE(immediate);
+  EXPECT_FALSE(immediate->should_prepare_paint_tree());
+}
